# Conexão com o PostgreSQL
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/abp_leads?schema=public"

# Segredo usado para assinar os tokens JWT — gere um valor forte e único.
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="defina-um-segredo-forte-e-unico"

# URL do frontend autorizado (CORS)
URL_CLIENT="http://localhost:3000"
